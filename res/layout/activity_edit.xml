<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/back" style="@style/IconButton" android:text="←" android:contentDescription="Back" />
        <TextView android:id="@+id/heading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="4dp" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text" />
        <TextView android:id="@+id/save" style="@style/TonalButton" android:text="Save" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="32dp">

            <LinearLayout android:id="@+id/logoRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card"
                android:padding="12dp" android:layout_marginTop="4dp">
                <ImageView android:id="@+id/logo" android:layout_width="56dp" android:layout_height="56dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="14dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Provider / logo"
                        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/text2" />
                    <TextView android:id="@+id/providerName" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textSize="17sp" android:textColor="@color/text" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choose ›"
                    android:textSize="14sp" android:textStyle="bold" android:textColor="@color/primary" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="Name" />
            <EditText android:id="@+id/title" style="@style/Field" android:hint="e.g. Google (work)" android:inputType="textCapWords"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="Username or email" />
            <EditText android:id="@+id/username" style="@style/Field" android:inputType="textEmailAddress"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="Password" />
            <EditText android:id="@+id/password" style="@style/Field" android:inputType="textPassword" android:fontFamily="monospace"
                android:importantForAutofill="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <TextView android:id="@+id/showPw" style="@style/TonalButton" android:text="Show" />
                <TextView android:id="@+id/generate" style="@style/TonalButton" android:layout_marginStart="8dp" android:text="🎲  Generate" />
            </LinearLayout>
            <TextView style="@style/Label" android:text="Website (optional)" />
            <EditText android:id="@+id/url" style="@style/Field" android:inputType="textUri" android:hint="accounts.google.com"
                android:importantForAutofill="no" />
            <TextView style="@style/Label" android:text="More fields" />
            <LinearLayout android:id="@+id/fieldsBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <TextView android:id="@+id/addField" style="@style/TonalButton" android:text="＋  Add field (PIN, security question, 2FA …)" />
            <TextView style="@style/Label" android:text="Notes (optional)" />
            <EditText android:id="@+id/notes" style="@style/Field" android:layout_height="wrap_content" android:minHeight="96dp"
                android:singleLine="false" android:gravity="top" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:inputType="textMultiLine|textCapSentences" android:importantForAutofill="no" />

            <TextView android:id="@+id/delete" style="@style/TextButton" android:layout_marginTop="24dp"
                android:text="Delete this login" android:textColor="@color/error" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
